{
	"name": "@boelabs/ai-sdk-provider",
	"version": "0.0.0",
	"description": "AI SDK provider for Boelabs AI Gateway: text (Responses or Chat Completions), embeddings, images, transcription, speech, reranking and video.",
	"keywords": [
		"ai",
		"ai-sdk",
		"vercel-ai",
		"provider",
		"boelabs",
		"ai-gateway",
		"llm"
	],
	"homepage": "https://boelabs.com/docs/ai-gateway/ai-sdk",
	"bugs": "https://github.com/boelabs/ai-gateway/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/boelabs/ai-gateway.git",
		"directory": "packages/ai-sdk-provider"
	},
	"license": "MIT",
	"author": "Boelabs",
	"sideEffects": false,
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsdown",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/provider": "4.0.39",
		"@ai-sdk/provider-utils": "5.0.83"
	},
	"devDependencies": {
		"@boelabs/tsconfig": "workspace:*",
		"ai": "7.0.179",
		"bun-types": "1.4.4",
		"tsdown": "0.23.7",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"zod": "^3.25.76 || ^4.1.8"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
