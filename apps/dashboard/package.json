{
	"name": "@boelabs/dashboard",
	"version": "0.0.0",
	"private": true,
	"description": "AI Gateway operator dashboard (Next.js App Router, Base UI with BaseLayer styling).",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"api:types": "bunx openapi-typescript@7.13.0 ../api/openapi.yaml -o src/shared/api/schema.d.ts",
		"build": "next build",
		"dev": "bun scripts/dev.ts",
		"start": "bun scripts/start.ts",
		"test": "bun test src/components/ui src/features src/shared",
		"typecheck": "next typegen && tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "4.0.103",
		"@ai-sdk/openai": "4.0.116",
		"@ai-sdk/openai-compatible": "3.0.91",
		"@ai-sdk/react": "4.0.175",
		"@base-ui/react": "1.9.0",
		"@phosphor-icons/react": "2.1.10",
		"@streamdown/math": "1.0.3",
		"@tailwindcss/postcss": "4.3.5",
		"ai": "7.0.171",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"d3-scale": "4.0.3",
		"d3-shape": "3.2.1",
		"katex": "0.19.1",
		"motion": "14.13.0",
		"next": "16.4.6",
		"openapi-fetch": "0.17.0",
		"react": "19.3.1",
		"react-day-picker": "10.0.2",
		"react-dom": "19.3.1",
		"shiki": "4.6.0",
		"streamdown": "2.7.1",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/d3-scale": "4.0.9",
		"@types/d3-shape": "3.2.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"bun-types": "1.4.4",
		"typescript": "7.0.2"
	}
}
