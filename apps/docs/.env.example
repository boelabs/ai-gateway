# AI Gateway documentation site. Nothing is required — the image runs with no configuration.

# Listen port. The image sets 3000; `bun run dev` reads DOCS_PORT first.
# PORT=3000
# DOCS_PORT=3000

# Public origin. Publishes /sitemap.xml and sets assetsBase in /docs/export.json; without it there is
# no sitemap and the export uses the request origin.
# DOCS_SITE_URL=https://docs.example.com
